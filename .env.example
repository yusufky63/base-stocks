# ---------- Public (sent to the browser) ----------
# Reown AppKit project id (https://cloud.reown.com). Optional: without it a minimal
# built-in wallet picker (Base Account, injected wallets) is used instead of the AppKit modal.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000   # production: https://basestocks.finance
# Optional dedicated RPC for browser reads (simulation / allowance checks). Public RPC otherwise.
NEXT_PUBLIC_BASE_RPC_URL=
# Base Builder Code from base.dev → Settings → Builder Code (ERC-8021 attribution).
NEXT_PUBLIC_BASE_BUILDER_CODE=bc_71vd6x2w
# Base app id for web attribution (meta tag base:app_id); default is the registered BStocks app
NEXT_PUBLIC_BASE_APP_ID=6a98cc686e87922b5d1d4597
# Optional paymaster URL for sponsored gas with Base Account (enhancement, not a dependency).
# This URL is handed to the wallet, so restrict it in the CDP portal (contract/method allowlist).
NEXT_PUBLIC_PAYMASTER_URL=

# ---------- Server-only (never prefixed with NEXT_PUBLIC_) ----------
# Dedicated Base mainnet RPC (recommended; public endpoints are rate limited).
BASE_RPC_URL=
# Optional second keyed RPC (dRPC); used after the primary, before the CDP fallback.
DRPC_RPC_URL=
# Flashblocks-aware RPC for preconfirmation status (defaults to BASE_RPC_URL / mainnet.base.org).
# 0x Swap API v2 key (https://dashboard.0x.org). Primary execution provider.
ZEROX_API_KEY=
# KyberSwap aggregator: NO API key is needed. Only a stable client id header is required.
KYBER_CLIENT_ID=bstocks-app
# KYBER_API_KEY=                # optional: higher KyberSwap rate limits
# OKX Onchain OS DEX API (optional fifth trade provider). All three are required together; the project must be
# entitled to the aggregator service, otherwise OKX answers 50125 and the provider is skipped.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OKX_PROJECT_ID=
# Market data: no key needed. DexScreener + GeckoTerminal public APIs are used with a shared
# server-side cache (one upstream fetch serves every visitor). Set a CoinGecko key only if you
# want the paid onchain API instead.
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
# Background market warm-up loop on the Node server (keeps the shared cache hot). Set to "false" to disable.
MARKET_WARMUP=true
# Supabase (optional). Without it the app uses in-memory storage.
SUPABASE_URL=
# Secret / service-role key from Project Settings → API keys (server only).
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key for the optional AI portfolio helper (cheap model by default, hard daily caps).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_DAILY_LIMIT_PER_WALLET=10
AI_DAILY_LIMIT_PER_IP=20
AI_GLOBAL_DAILY_LIMIT=500
AI_BURST_LIMIT_PER_IP=4
# Postgres connection string, only for `pnpm db:apply` (Supabase → Project Settings → Database).
DATABASE_URL=
# Oracle staleness threshold in seconds (default 3600).
ORACLE_STALENESS_SECONDS=93600
# Optional integrator fee for 0x (bps + recipient). Leave empty for none.
ZEROX_SWAP_FEE_BPS=
ZEROX_SWAP_FEE_RECIPIENT=
# Admin token for /api/admin/* and the /admin page (min 16 chars).
ADMIN_API_TOKEN=
# Vercel Cron → /api/cron/refresh (discovery scan + status probes on serverless). Any random 32+ char string.
CRON_SECRET=
# HMAC secret for sign-in sessions (min 16 chars). Without it sessions reset on every restart.
AUTH_SECRET=

# ---------- Contract deployment only (never read by the app at runtime) ----------
# Deployer key for `forge create` / `forge verify-contract` under contracts/. Keep it out of Vercel.
PRIVATE_KEY=
# Etherscan/Basescan API key for source verification (optional).
ETHERSCAN_API_KEY=

# Compliance: comma-separated ISO country codes that must not trade or use Earn execution (default US).
# Enforced in src/proxy.ts from the hosting provider's geo header (x-vercel-ip-country / cf-ipcountry).
GEOBLOCK_COUNTRIES=US
# block = execution routes answer 451; attest = show the eligibility notice and let the visitor self-certify (cookie, 30 days)
GEOBLOCK_MODE=attest

# AI helper cost controls. Provider "anthropic" (default) uses ANTHROPIC_API_KEY + AI_MODEL (claude-haiku-4-5).
# Provider "openai" talks to any OpenAI-compatible endpoint (DeepSeek, OpenRouter, local) with AI_API_KEY / AI_BASE_URL / AI_MODEL.
# The helper turns itself off for the rest of the month once the estimated spend reaches AI_MONTHLY_BUDGET_USD.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MONTHLY_BUDGET_USD=10
AI_MAX_OUTPUT_TOKENS=700

# Uniswap Trading API key (developers.uniswap.org). Adds the Uniswap route (proxy-approval flow, no Permit2) behind KyberSwap.
UNISWAP_API_KEY=

# ---------- Gift pools (GiftPool contract) ----------
# Deployed GiftPool address. Empty = the pools feature stays hidden.
NEXT_PUBLIC_GIFT_POOL_ADDRESS=
# Campaign signer for quest-gated pools (server-only, 32-byte hex key). Without it, open and
# link-gated pools still work; only quest gating is unavailable.
POOL_GATE_SIGNER_KEY=

# ---------- Base app (mini app) ----------
# Ownership proof for /.well-known/farcaster.json. Produced once per domain in the Base or
# Farcaster developer tool and pasted here; the manifest omits the block entirely until all three
# are set, so an unsigned deployment reads as unsigned rather than as a broken signature.
FARCASTER_ACCOUNT_HEADER=
FARCASTER_ACCOUNT_PAYLOAD=
FARCASTER_ACCOUNT_SIGNATURE=
# Wallets allowed to manage this mini app in the Base build tools. Comma separated, 0x addresses.
BASE_BUILDER_ALLOWED_ADDRESSES=
# Extra origins allowed to embed the site in a frame, on top of the Base and Farcaster hosts that
# are always allowed. Space or comma separated. Only needed if a new host appears.
FRAME_ANCESTORS_EXTRA=
